{
  "name": "agora-integration-poc",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:studio": "drizzle-kit studio --schema ./src/db/schema.ts",
    "db:generate": "drizzle-kit generate",
    "auth:schema": "bunx auth@latest generate --config ./better-auth.config.ts --output src/db/auth.schema.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "agora-rtc-sdk-ng": "^4.24.9",
    "agora-token": "^2.0.7",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^1.0.0-rc.5",
    "hono": "^4.13.14",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "daisyui": "^5.7.50",
    "drizzle-kit": "^1.0.0-rc.5",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.8.0",
    "wrangler": "^4.110.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}